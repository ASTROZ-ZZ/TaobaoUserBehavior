                "      {19,5430878,115032,1147819,92903},",
                "      {20,6586331,133863,1296836,107285},",
                "      {21,7538383,145433,1402635,115125},",
                "      {22,7443073,138268,1331737,107562},",
                "      {23,5599903,100075,974238,75808}",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Hour\", Int64.Type}, {\"PV\", Int64.Type}, {\"BuyLogs\", Int64.Type}, {\"ActiveUserHours\", Int64.Type}, {\"BuyerUserHours\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
