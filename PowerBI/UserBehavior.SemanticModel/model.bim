      {
        "name": "Segments",
        "columns": [
          {
            "name": "Segment",
            "dataType": "string",
            "sourceColumn": "Segment",
            "summarizeBy": "none"
          },
          {
            "name": "Users",
            "dataType": "int64",
            "sourceColumn": "Users",
            "summarizeBy": "none"
          },
          {
            "name": "PV",
            "dataType": "int64",
            "sourceColumn": "PV",
            "summarizeBy": "none"
          },
          {
            "name": "Buyers",
            "dataType": "int64",
            "sourceColumn": "Buyers",
            "summarizeBy": "none"
          },
          {
            "name": "MeanActiveDays",
            "dataType": "double",
            "sourceColumn": "MeanActiveDays",
            "summarizeBy": "none"
          },
          {
            "name": "MeanPurchaseDays",
            "dataType": "double",
            "sourceColumn": "MeanPurchaseDays",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "分层人数",
            "expression": "SUM(Segments[Users])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "分层用户占比",
            "expression": "DIVIDE(SUM(Segments[Users]),CALCULATE(SUM(Segments[Users]),ALL(Segments)))",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          }
        ],
        "partitions": [
          {
            "name": "Segments",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"Segment\", \"Users\", \"PV\", \"Buyers\", \"MeanActiveDays\", \"MeanPurchaseDays\"}, {",
                "      {\"低活跃＋低购买\",270845,11717913,116971,5.040573,0.43187432},",
                "      {\"低活跃＋高购买\",79632,4041538,79632,5.2886654,2.3876833},",
                "      {\"高活跃＋低购买\",346872,36855305,185159,8.0137774,0.53379633},",
                "      {\"高活跃＋高购买\",290642,37045932,290642,8.2659354,2.9012118}",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Segment\", type text}, {\"Users\", Int64.Type}, {\"PV\", Int64.Type}, {\"Buyers\", Int64.Type}, {\"MeanActiveDays\", type number}, {\"MeanPurchaseDays\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Intents",
        "columns": [
          {
            "name": "Segment",
            "dataType": "string",
            "sourceColumn": "Segment",
            "summarizeBy": "none"
          },
          {
            "name": "Intent",
            "dataType": "string",
            "sourceColumn": "Intent",
            "summarizeBy": "none"
          },
          {
            "name": "Users",
            "dataType": "int64",
            "sourceColumn": "Users",
