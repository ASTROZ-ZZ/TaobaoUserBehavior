            "sourceColumn": "RepeatUsers",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "三日再次购买率",
            "expression": "DIVIDE(SUM(Repeat[RepeatUsers]),SUM(Repeat[Users]))",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          }
