        "name": "WeekType",
        "columns": [
          {
            "name": "DayType",
            "dataType": "string",
            "sourceColumn": "DayType",
            "summarizeBy": "none"
          },
          {
            "name": "Days",
            "dataType": "int64",
            "sourceColumn": "Days",
            "summarizeBy": "none"
          },
          {
            "name": "PV",
            "dataType": "int64",
            "sourceColumn": "PV",
            "summarizeBy": "none"
          },
          {
            "name": "ActiveUserDays",
            "dataType": "int64",
            "sourceColumn": "ActiveUserDays",
            "summarizeBy": "none"
          },
          {
            "name": "BuyerUserDays",
            "dataType": "int64",
            "sourceColumn": "BuyerUserDays",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "日均PV",
            "expression": "DIVIDE(SUM(WeekType[PV]),SUM(WeekType[Days]))",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "日均活跃",
            "expression": "DIVIDE(SUM(WeekType[ActiveUserDays]),SUM(WeekType[Days]))",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "周末购买用户日占比",
            "expression": "CALCULATE(DIVIDE(SUM(WeekType[BuyerUserDays]),SUM(WeekType[ActiveUserDays])),WeekType[DayType]=\"周末\")",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "购买用户日占比",
            "expression": "DIVIDE(SUM(WeekType[BuyerUserDays]),SUM(WeekType[ActiveUserDays]))",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          }
        ],
        "partitions": [
          {
            "name": "WeekType",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"DayType\", \"Days\", \"PV\", \"ActiveUserDays\", \"BuyerUserDays\"}, {",
                "      {\"工作日\",5,46172898,3609009,719098},",
                "      {\"周末\",4,43487790,3359535,616382}",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"DayType\", type text}, {\"Days\", Int64.Type}, {\"PV\", Int64.Type}, {\"ActiveUserDays\", Int64.Type}, {\"BuyerUserDays\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
