{
  "name": "UserBehavior",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "zh-CN",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "zh-CN",
    "tables": [
      {
        "name": "Period",
        "columns": [
          {
            "name": "Events",
            "dataType": "int64",
            "sourceColumn": "Events",
            "summarizeBy": "none"
          },
          {
            "name": "Users",
            "dataType": "int64",
            "sourceColumn": "Users",
            "summarizeBy": "none"
          },
          {
            "name": "PV",
            "dataType": "int64",
            "sourceColumn": "PV",
            "summarizeBy": "none"
          },
          {
            "name": "Browsers",
            "dataType": "int64",
            "sourceColumn": "Browsers",
            "summarizeBy": "none"
          },
          {
            "name": "FavoriteUsers",
            "dataType": "int64",
            "sourceColumn": "FavoriteUsers",
            "summarizeBy": "none"
          },
          {
            "name": "CartUsers",
            "dataType": "int64",
            "sourceColumn": "CartUsers",
            "summarizeBy": "none"
          },
          {
            "name": "Buyers",
            "dataType": "int64",
            "sourceColumn": "Buyers",
            "summarizeBy": "none"
          },
          {
            "name": "BuyLogs",
            "dataType": "int64",
            "sourceColumn": "BuyLogs",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "全期PV",
            "expression": "SUM(Period[PV])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "全期UV",
            "expression": "MAX(Period[Users])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "全期购买用户占比",
            "expression": "DIVIDE(MAX(Period[Buyers]),MAX(Period[Users]))",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "人均浏览量",
            "expression": "DIVIDE(SUM(Period[PV]),MAX(Period[Browsers]))",
            "formatString": "0.00",
            "displayFolder": "业务指标"
          }
        ],
        "partitions": [
          {
            "name": "Period",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"Events\", \"Users\", \"PV\", \"Browsers\", \"FavoriteUsers\", \"CartUsers\", \"Buyers\", \"BuyLogs\"}, {",
                "      {100095231,987991,89660688,984105,389823,738996,672404,2015839}",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Events\", Int64.Type}, {\"Users\", Int64.Type}, {\"PV\", Int64.Type}, {\"Browsers\", Int64.Type}, {\"FavoriteUsers\", Int64.Type}, {\"CartUsers\", Int64.Type}, {\"Buyers\", Int64.Type}, {\"BuyLogs\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Daily",
        "columns": [
          {
            "name": "Date",
            "dataType": "string",
            "sourceColumn": "Date",
            "summarizeBy": "none"
          },
          {
            "name": "Day",
            "dataType": "int64",
            "sourceColumn": "Day",
            "summarizeBy": "none"
          },
          {
            "name": "PV",
            "dataType": "int64",
            "sourceColumn": "PV",
            "summarizeBy": "none"
          },
          {
            "name": "DAU",
            "dataType": "int64",
            "sourceColumn": "DAU",
            "summarizeBy": "none"
          },
          {
            "name": "Buyers",
            "dataType": "int64",
            "sourceColumn": "Buyers",
            "summarizeBy": "none"
          },
          {
            "name": "BuyLogs",
            "dataType": "int64",
            "sourceColumn": "BuyLogs",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "日活用户",
            "expression": "SUM(Daily[DAU])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "每日PV",
            "expression": "SUM(Daily[PV])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "每日购买人数",
            "expression": "SUM(Daily[Buyers])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "日购买用户占比",
            "expression": "DIVIDE(SUM(Daily[Buyers]),SUM(Daily[DAU]))",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          }
        ],
        "partitions": [
          {
            "name": "Daily",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"Date\", \"Day\", \"PV\", \"DAU\", \"Buyers\", \"BuyLogs\"}, {",
                "      {\"2017-11-25\",0,9353423,706641,132622,201145},",
                "      {\"2017-11-26\",1,9567423,715516,136048,205644},",
                "      {\"2017-11-27\",2,9041187,710094,146934,226835},",
                "      {\"2017-11-28\",3,8842933,709257,139845,212000},",
                "      {\"2017-11-29\",4,9210821,718922,146220,223072},",
                "      {\"2017-11-30\",5,9358998,730597,146128,221463},",
                "      {\"2017-12-01\",6,9718959,740139,139971,210016},",
                "      {\"2017-12-02\",7,12329644,970401,174487,257907},",
                "      {\"2017-12-03\",8,12237300,966977,173225,257757}",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Date\", type text}, {\"Day\", Int64.Type}, {\"PV\", Int64.Type}, {\"DAU\", Int64.Type}, {\"Buyers\", Int64.Type}, {\"BuyLogs\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Conversion",
        "columns": [
          {
            "name": "Behavior",
            "dataType": "string",
            "sourceColumn": "Behavior",
            "summarizeBy": "none"
          },
          {
            "name": "Eligible",
            "dataType": "int64",
            "sourceColumn": "Eligible",
            "summarizeBy": "none"
          },
          {
            "name": "Converted",
            "dataType": "int64",
            "sourceColumn": "Converted",
            "summarizeBy": "none"
          },
          {
            "name": "Censored",
            "dataType": "int64",
            "sourceColumn": "Censored",
            "summarizeBy": "none"
          },
          {
            "name": "NotConverted",
            "dataType": "int64",
            "sourceColumn": "NotConverted",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "24h转化率",
            "expression": "IF(HASONEVALUE(Conversion[Behavior]),DIVIDE(SUM(Conversion[Converted]),SUM(Conversion[Eligible])),BLANK())",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "浏览后24h购买率",
            "expression": "CALCULATE(DIVIDE(SUM(Conversion[Converted]),SUM(Conversion[Eligible])),Conversion[Behavior]=\"浏览\")",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "加购后24h购买率",
            "expression": "CALCULATE(DIVIDE(SUM(Conversion[Converted]),SUM(Conversion[Eligible])),Conversion[Behavior]=\"加购\")",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "收藏后24h购买率",
            "expression": "CALCULATE(DIVIDE(SUM(Conversion[Converted]),SUM(Conversion[Eligible])),Conversion[Behavior]=\"收藏\")",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "加购24h未购对数",
            "expression": "CALCULATE(SUM(Conversion[NotConverted]),Conversion[Behavior]=\"加购\")",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "合格起点对数",
            "expression": "SUM(Conversion[Eligible])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "转化对数",
            "expression": "SUM(Conversion[Converted])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          }
        ],
        "partitions": [
          {
            "name": "Conversion",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"Behavior\", \"Eligible\", \"Converted\", \"Censored\", \"NotConverted\"}, {",
                "      {\"加购\",4639111,183827,747473,4455284},",
                "      {\"收藏\",2481639,85661,388338,2395978},",
                "      {\"浏览\",61713539,735437,9301653,60978102}",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Behavior\", type text}, {\"Eligible\", Int64.Type}, {\"Converted\", Int64.Type}, {\"Censored\", Int64.Type}, {\"NotConverted\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Hours",
        "columns": [
          {
            "name": "Hour",
            "dataType": "int64",
            "sourceColumn": "Hour",
            "summarizeBy": "none"
