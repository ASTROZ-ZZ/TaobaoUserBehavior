            "summarizeBy": "none"
          },
          {
            "name": "PeakPVHour",
            "dataType": "int64",
            "sourceColumn": "PeakPVHour",
            "summarizeBy": "none"
          },
          {
            "name": "PeakBuyHour",
            "dataType": "int64",
            "sourceColumn": "PeakBuyHour",
            "summarizeBy": "none"
          },
          {
            "name": "PeakOnsetHour",
            "dataType": "int64",
            "sourceColumn": "PeakOnsetHour",
            "summarizeBy": "none"
          },
          {
            "name": "PrioritySKU",
            "dataType": "string",
            "sourceColumn": "PrioritySKU",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "全量商品数",
            "expression": "MAX(Scope[AllProducts])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "合格商品数",
            "expression": "MAX(Scope[EligibleProducts])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "商品入榜覆盖",
            "expression": "DIVIDE(MAX(Scope[EligibleProducts]),MAX(Scope[AllProducts]))",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "浏览高峰小时",
            "expression": "MAX(Scope[PeakPVHour])",
            "formatString": "0\"时\"",
            "displayFolder": "业务指标"
          },
          {
            "name": "购买高峰小时",
            "expression": "MAX(Scope[PeakBuyHour])",
            "formatString": "0\"时\"",
            "displayFolder": "业务指标"
          },
          {
            "name": "起点转化高峰小时",
            "expression": "MAX(Scope[PeakOnsetHour])",
            "formatString": "0\"时\"",
            "displayFolder": "业务指标"
          },
          {
            "name": "优先排查商品",
            "expression": "SELECTEDVALUE(Scope[PrioritySKU])",
            "formatString": "",
            "displayFolder": "业务指标"
          },
          {
            "name": "高活跃低购买人数",
            "expression": "MAX(Scope[HighActiveLowBuyUsers])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "高活跃未购加购人数",
            "expression": "MAX(Scope[HighActiveNeverBuyCartUsers])",
            "formatString": "#,0",
            "displayFolder": "业务指标"
          },
          {
            "name": "跨日购买用户占比",
            "expression": "DIVIDE(MAX(Scope[MultiBuyDayUsers]),MAX(Scope[AllBuyers]))",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          }
        ],
        "partitions": [
          {
            "name": "Scope",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table({\"AllProducts\", \"EligibleProducts\", \"TrafficThreshold\", \"RateThreshold\", \"HighActiveLowBuyUsers\", \"HighActiveNeverBuyCartUsers\", \"MultiBuyDayUsers\", \"AllBuyers\", \"PeakPVHour\", \"PeakBuyHour\", \"PeakOnsetHour\", \"PrioritySKU\"}, {",
                "      {4161138,110545,344,0.0067567568,346872,117340,370274,672404,21,21,10,\"812879\"}",
                "    }),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"AllProducts\", Int64.Type}, {\"EligibleProducts\", Int64.Type}, {\"TrafficThreshold\", Int64.Type}, {\"RateThreshold\", type number}, {\"HighActiveLowBuyUsers\", Int64.Type}, {\"HighActiveNeverBuyCartUsers\", Int64.Type}, {\"MultiBuyDayUsers\", Int64.Type}, {\"AllBuyers\", Int64.Type}, {\"PeakPVHour\", Int64.Type}, {\"PeakBuyHour\", Int64.Type}, {\"PeakOnsetHour\", Int64.Type}, {\"PrioritySKU\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"Period\", \"Daily\", \"Conversion\", \"Hours\", \"OnsetHours\", \"Segments\", \"Intents\", \"Cohort\", \"Repeat\", \"Windows\", \"History\", \"WeekType\", \"Products\", \"Scope\"]"
      }
    ]
  }
}