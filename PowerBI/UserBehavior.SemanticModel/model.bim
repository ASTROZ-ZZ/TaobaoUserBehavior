      {
        "name": "Cohort",
        "columns": [
          {
            "name": "CohortDay",
            "dataType": "int64",
            "sourceColumn": "CohortDay",
            "summarizeBy": "none"
          },
          {
            "name": "CohortDate",
            "dataType": "string",
            "sourceColumn": "CohortDate",
            "summarizeBy": "none"
          },
          {
            "name": "Offset",
            "dataType": "int64",
            "sourceColumn": "Offset",
            "summarizeBy": "none"
          },
          {
            "name": "BaseUsers",
            "dataType": "int64",
            "sourceColumn": "BaseUsers",
            "summarizeBy": "none"
          },
          {
            "name": "Retained",
            "dataType": "int64",
            "sourceColumn": "Retained",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "精确日留存率",
            "expression": "IF(HASONEVALUE(Cohort[Offset]),DIVIDE(SUM(Cohort[Retained]),SUMX(FILTER(Cohort,NOT ISBLANK(Cohort[Retained])),Cohort[BaseUsers])),BLANK())",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "同批用户D1",
            "expression": "CALCULATE(DIVIDE(SUM(Cohort[Retained]),SUM(Cohort[BaseUsers])),REMOVEFILTERS(Cohort),Cohort[CohortDay]<=1,Cohort[Offset]=1)",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "同批用户D3",
            "expression": "CALCULATE(DIVIDE(SUM(Cohort[Retained]),SUM(Cohort[BaseUsers])),REMOVEFILTERS(Cohort),Cohort[CohortDay]<=1,Cohort[Offset]=3)",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          },
          {
            "name": "同批用户D7",
            "expression": "CALCULATE(DIVIDE(SUM(Cohort[Retained]),SUM(Cohort[BaseUsers])),REMOVEFILTERS(Cohort),Cohort[CohortDay]<=1,Cohort[Offset]=7)",
            "formatString": "0.00%",
            "displayFolder": "业务指标"
          }
        ],
        "partitions": [
          {
            "name": "Cohort",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
